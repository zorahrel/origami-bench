#!/usr/bin/env python3
"""origami-bench: how much can a model fold into 8,000 tokens? Stdlib only (+ playwright for render.py).
  bench run [--models a,b] [--tasks x,y] [--no-judge] [--force] [--date YYYY-MM-DD]
  bench report [--date D]      bench list      bench gifs [--date D]
One cell = (model, task): generate -> html -> WebKit render (video + checks) -> judge score -> results/<date>.md"""
import sys, os, re, json, time, subprocess, pathlib, argparse, tempfile, datetime, urllib.request, concurrent.futures as cf

ROOT = pathlib.Path(__file__).resolve().parent
TOK_LIMIT = 8000
RUBRIC = ("This video shows a web page generated by an AI model for the task: \"{task}\". "
          "Give a score from 1 to 10 using this fixed rubric: 1-2 blank/broken/static; 3-4 something moves but it is poor or off-task; "
          "5-6 task recognisable, simple animation; 7-8 task met well, smooth animation and detail (lights, shadows, articulation, depth); "
          "9-10 surprising, rich, near-professional. Judge ONLY what you see. "
          "Reply with the first line exactly 'SCORE: <n>' followed by at most two sentences of justification.")

def load_models():
    ms = {}
    for name in ("models.conf", "models.local.conf"):  # the local one is git-ignored: your private extras
        f = ROOT / name
        if not f.exists(): continue
        for ln in f.read_text().splitlines():
            ln = ln.split("#", 1)[0].strip()
            if not ln: continue
            parts = ln.split(None, 2)
            ms[parts[0]] = (parts[1], parts[2] if len(parts) > 2 else "")
    return ms

def load_tasks():
    d = json.loads((ROOT / "tasks" / "tasks.json").read_text())
    return {k: d["preamble"] + "\n\n" + v for k, v in d["tasks"].items()}, d["tasks"]

# ---- adapter: ritornano (testo, in_tok, out_tok) ; None = non disponibile ----
def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=kw.pop("timeout", 900), stdin=subprocess.DEVNULL, **kw)

def a_claude(model, prompt, wd):
    r = run(["claude", "-p", "--model", model, "--tools", "", "--output-format", "json"] + [prompt], cwd=wd)
    j = json.loads(r.stdout); u = j.get("usage", {})
    return j.get("result", ""), (u.get("input_tokens", 0) + u.get("cache_creation_input_tokens", 0) + u.get("cache_read_input_tokens", 0)), u.get("output_tokens")

def a_codex(model, prompt, wd):
    r = run(["codex", "exec", "-m", model, "--skip-git-repo-check", "--json", "-s", "read-only", prompt], cwd=wd)
    text, i, o = "", None, None
    for ln in r.stdout.splitlines():
        try: e = json.loads(ln)
        except Exception: continue
        if e.get("type") == "item.completed" and e["item"].get("type") == "agent_message": text = e["item"]["text"]
        if e.get("type") == "turn.completed":
            u = e["usage"]; i = u.get("input_tokens"); o = (u.get("output_tokens") or 0)
    return text, i, o

def a_openai(model, prompt, wd):
    # any OpenAI-compatible endpoint: BENCH_OPENAI_BASE (default https://api.openai.com/v1), key in BENCH_OPENAI_KEY
    base = os.environ.get("BENCH_OPENAI_BASE", "https://api.openai.com/v1").rstrip("/")
    hdr = {"content-type": "application/json"}
    if os.environ.get("BENCH_OPENAI_KEY"): hdr["authorization"] = "Bearer " + os.environ["BENCH_OPENAI_KEY"]
    body = json.dumps({"model": model, "messages": [{"role": "user", "content": prompt}], "max_tokens": 14000}).encode()
    j = json.load(urllib.request.urlopen(urllib.request.Request(base + "/chat/completions", body, hdr), timeout=900)); u = j.get("usage", {})
    return j["choices"][0]["message"].get("content") or "", u.get("prompt_tokens"), u.get("completion_tokens")

def a_agentdir(cmdname, prompt, wd):
    # a CLI agent invoked as `<cmd> -C <dir> <prompt>` that may save an .html in the dir instead of replying with it
    r = run([cmdname, "-C", wd, prompt])
    text = r.stdout
    fs = sorted(pathlib.Path(wd).glob("*.html"))
    if "<html" not in text.lower() and fs: text = fs[0].read_text()
    return text, None, None  # tokens not exposed: estimated from characters

def a_cmd(cmdline, prompt, wd):
    pf = pathlib.Path(wd) / "prompt.txt"; pf.write_text(prompt)
    r = subprocess.run(cmdline, shell=True, capture_output=True, text=True, timeout=900, cwd=wd, env={**os.environ, "PROMPT_FILE": str(pf)}, stdin=subprocess.DEVNULL)
    return r.stdout, None, None

ADAPT = {"claude": a_claude, "codex": a_codex, "openai": a_openai, "agentdir": a_agentdir, "cmd": a_cmd}

def extract_html(text):
    m = re.search(r"```(?:html)?\s*\n(.*?)```", text, re.S | re.I)
    if m and "<" in m.group(1): text = m.group(1)
    m = re.search(r"(<!doctype html.*</html>|<html.*</html>)", text, re.S | re.I)
    if m: return m.group(1)
    return text.strip() if "<" in text else ""

def est_tokens(s): return round(len(s) / 3.5)

def gen_cell(model, task, prompt, ad, arg, cell):
    cell.mkdir(parents=True, exist_ok=True)
    if (cell / "out.html").exists() and (cell / "meta.json").exists(): return json.loads((cell / "meta.json").read_text())
    wd = tempfile.mkdtemp(prefix="bench-")
    t0 = time.time(); err = None; text = ""; i = o = None
    try: text, i, o = ADAPT[ad](arg, prompt, wd)
    except Exception as e: err = f"{type(e).__name__}: {e}"[:300]
    dt = round(time.time() - t0, 1)
    (cell / "raw.txt").write_text(text or "")
    html = extract_html(text or "")
    (cell / "out.html").write_text(html)
    meta = {"gen_seconds": dt, "in_tokens": i, "out_tokens": o if o is not None else est_tokens(text or ""),
            "out_tokens_estimated": o is None, "html_bytes": len(html), "error": err}
    meta["over_budget"] = meta["out_tokens"] > TOK_LIMIT
    (cell / "meta.json").write_text(json.dumps(meta))
    return meta

def render_cell(cell):
    if (cell / "auto.json").exists(): return json.loads((cell / "auto.json").read_text())
    html = cell / "out.html"
    if not html.exists() or html.stat().st_size < 50:
        res = {"not_blank": False, "animated": False, "n_errors": 0, "console_errors": ["no HTML produced"], "diffs": []}
    else:
        try:
            r = subprocess.run([sys.executable, "-I", str(ROOT / "render.py"), str(html), str(cell)], capture_output=True, text=True, timeout=120)
            res = json.loads(r.stdout.strip().splitlines()[-1])
        except Exception as e:
            res = {"not_blank": False, "animated": False, "n_errors": 1, "console_errors": [f"render failed: {e}"[:200]], "diffs": []}
    (cell / "auto.json").write_text(json.dumps(res))
    return res

def judge_cell(cell, task_desc, auto):
    """Judge = any command in $BENCH_JUDGE_CMD (default: judges/gemini.py). It gets $VIDEO and $PROMPT_FILE and prints
    'SCORE: <n>' on the first line, then a short justification."""
    f = cell / "judge.json"
    if f.exists(): return json.loads(f.read_text())
    vid = cell / "video.webm"
    if not (auto["not_blank"] and vid.exists()):
        j = {"score": 1, "why": "blank or not rendered (judge not called)"}
    else:
        try:
            pf = cell / "_judge_prompt.txt"; pf.write_text(RUBRIC.format(task=task_desc))
            cmd = os.environ.get("BENCH_JUDGE_CMD") or f'"{sys.executable}" "{ROOT / "judges" / "gemini.py"}"'
            r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=400, stdin=subprocess.DEVNULL,
                               env={**os.environ, "VIDEO": str(vid), "PROMPT_FILE": str(pf)})
            pf.unlink(missing_ok=True)
            m = re.search(r"SCORE:\s*(\d+)", r.stdout)
            j = {"score": min(10, int(m.group(1))) if m else None, "why": (r.stdout.split("\n", 1)[1] if m and "\n" in r.stdout else r.stdout)[:400].strip().replace("\n", " ")}
            if not m: j["why"] = "judge returned no SCORE: " + (r.stdout + r.stderr)[:200]
        except Exception as e: j = {"score": None, "why": f"judge failed: {e}"[:200]}
        if j["score"] is not None and not auto["animated"]: j["score"] = min(j["score"], 4); j["why"] += " [capped at 4: no animation detected]"
    if j["score"] is not None: f.write_text(json.dumps(j))
    return j

def report(date, models, tasks):
    base = ROOT / "runs" / date; rows = []; cells = {}
    for m in models:
        sc, ts, tk, anim, ok = [], 0, 0, 0, 0
        for t in tasks:
            c = base / m / t
            if not (c / "meta.json").exists(): continue
            meta = json.loads((c / "meta.json").read_text()); auto = json.loads((c / "auto.json").read_text()) if (c / "auto.json").exists() else {}
            j = json.loads((c / "judge.json").read_text()) if (c / "judge.json").exists() else {"score": None, "why": "not judged"}
            cells[(m, t)] = (meta, auto, j)
            if j["score"] is not None: sc.append(j["score"])
            ts += meta["gen_seconds"]; tk += meta["out_tokens"]; anim += bool(auto.get("animated")); ok += bool(auto.get("not_blank")) and auto.get("n_errors", 0) == 0
        if sc or cells: rows.append((m, sum(sc) / len(sc) if sc else 0, ts, tk, anim, ok, len([t for t in tasks if (m, t) in cells])))
    rows.sort(key=lambda r: (-r[1], r[2]))
    L = [f"# Results {date}", "", f"Output limit {TOK_LIMIT} tokens. Score = mean video-judge rating 1-10, capped at 4 if not animated. `~` = estimated tokens (chars/3.5).", "",
         "## Leaderboard", "", "| # | model | mean score | total time | output tokens | animated | clean (no errors, not blank) |", "|---|---|---|---|---|---|---|"]
    for n, (m, avg, ts, tk, an, ok, nc) in enumerate(rows, 1):
        est = "~" if any(cells[(m, t)][0]["out_tokens_estimated"] for t in tasks if (m, t) in cells) else ""
        L.append(f"| {n} | {m} | {avg:.1f} | {ts:.0f}s | {est}{tk} | {an}/{nc} | {ok}/{nc} |")
    L += ["", "## Cells", "", "| model | task | score | time | output tokens | animated | console errors | page | judge note |", "|---|---|---|---|---|---|---|---|---|"]
    for m in models:
        for t in tasks:
            if (m, t) not in cells: continue
            meta, auto, j = cells[(m, t)]
            tk = ("~" if meta["out_tokens_estimated"] else "") + str(meta["out_tokens"]) + (" ⚠ over budget" if meta["over_budget"] else "")
            L.append(f"| {m} | {t} | {j['score'] if j['score'] is not None else '-'} | {meta['gen_seconds']}s | {tk} | {'yes' if auto.get('animated') else 'no'} | {auto.get('n_errors', '-')} | [html](../runs/{date}/{m}/{t}/out.html) | {(j['why'] or meta['error'] or '').replace('|', '/')[:140]} |")
    out = ROOT / "results" / f"{date}.md"; out.write_text("\n".join(L) + "\n")
    return out, rows

def make_gifs(date, models, tasks):
    """Best-scoring cell per task -> docs/<task>.gif (needs ffmpeg). Prints the winners."""
    (ROOT / "docs").mkdir(exist_ok=True); base = ROOT / "runs" / date
    for t in tasks:
        best = None
        for m in models:
            c = base / m / t
            if not (c / "judge.json").exists() or not (c / "video.webm").exists(): continue
            sc = json.loads((c / "judge.json").read_text())["score"]
            if best is None or sc > best[0]: best = (sc, m, c)
        if not best: continue
        out = ROOT / "docs" / f"{t}.gif"
        vf = "fps=8,scale=400:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=64[p];[b][p]paletteuse=dither=bayer:bayer_scale=4"
        subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", "0.8", "-i", str(best[2] / "video.webm"), "-vf", vf, str(out)], check=True)
        print(f"{t}: {best[1]} ({best[0]}/10) -> {out.name} {out.stat().st_size // 1024}KB")
    return 0

def main():
    ap = argparse.ArgumentParser(); ap.add_argument("cmd", choices=["run", "report", "list", "gifs"])
    ap.add_argument("--models"); ap.add_argument("--tasks"); ap.add_argument("--date", default=datetime.date.today().isoformat())
    ap.add_argument("--no-judge", action="store_true"); ap.add_argument("--force", action="store_true"); ap.add_argument("--jobs", type=int, default=4)
    a = ap.parse_args()
    models = load_models(); prompts, descs = load_tasks()
    if a.cmd == "list":
        for k, (ad, arg) in models.items(): print(k, ad, arg)
        print("tasks:", ", ".join(prompts)); return 0
    ms = a.models.split(",") if a.models else list(models); ts = a.tasks.split(",") if a.tasks else list(prompts)
    for m in ms:
        if m not in models: sys.exit(f"unknown model: {m} (see models.conf)")
    if a.cmd == "run":
        base = ROOT / "runs" / a.date
        if a.force:
            import shutil; [shutil.rmtree(base / m / t, ignore_errors=True) for m in ms for t in ts]
        print(f"generating {len(ms) * len(ts)} cells, {a.jobs} jobs in parallel...", flush=True)
        with cf.ThreadPoolExecutor(a.jobs) as ex:
            futs = {ex.submit(gen_cell, m, t, prompts[t], *models[m], base / m / t): (m, t) for m in ms for t in ts}
            for f in cf.as_completed(futs):
                m, t = futs[f]; meta = f.result(); print(f"  gen {m}/{t}: {meta['gen_seconds']}s {meta['out_tokens']}tok {meta['html_bytes']}B {meta['error'] or ''}", flush=True)
        def post(mt):
            m, t = mt; c = base / m / t; auto = render_cell(c)
            j = {"score": None} if a.no_judge else judge_cell(c, descs[t], auto)
            print(f"  {m}/{t}: blank={not auto['not_blank']} anim={auto['animated']} err={auto['n_errors']} score={j['score']}", flush=True)
        with cf.ThreadPoolExecutor(3) as ex: list(ex.map(post, [(m, t) for m in ms for t in ts]))
    if a.cmd == "gifs": return make_gifs(a.date, ms, ts)
    out, rows = report(a.date, ms, ts)
    print("\nreport:", out)
    for r in rows: print(f"  {r[0]:18} score {r[1]:.1f}  {r[2]:.0f}s  {r[3]}tok  anim {r[4]}/{r[6]}")
    return 0

if __name__ == "__main__": sys.exit(main())
